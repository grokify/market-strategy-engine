{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/market-strategy-engine/schema/segment.schema.json",
  "$ref": "#/$defs/Segment",
  "$defs": {
    "Segment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "minEndpoints": {
          "type": "integer"
        },
        "maxEndpoints": {
          "type": "integer"
        },
        "characteristics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}