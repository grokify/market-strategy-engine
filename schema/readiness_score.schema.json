{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/market-strategy-engine/schema/readiness_score.schema.json",
  "$ref": "#/$defs/ReadinessScore",
  "$defs": {
    "GapAnalysis": {
      "properties": {
        "vendorId": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        },
        "segmentId": {
          "type": "string"
        },
        "benchmarkScore": {
          "type": "number"
        },
        "benchmarkVendorId": {
          "type": "string"
        },
        "vendorScore": {
          "type": "number"
        },
        "gap": {
          "type": "number"
        },
        "segmentWeight": {
          "type": "number"
        },
        "weightedGap": {
          "type": "number"
        },
        "gapType": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ReadinessScore": {
      "properties": {
        "vendorId": {
          "type": "string"
        },
        "segmentId": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "maxPossible": {
          "type": "number"
        },
        "totalWeightedGap": {
          "type": "number"
        },
        "criticalGaps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "topGaps": {
          "items": {
            "$ref": "#/$defs/GapAnalysis"
          },
          "type": "array"
        },
        "interpretation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}