{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/market-strategy-engine/schema/vendor_segment_score.schema.json",
  "$ref": "#/$defs/VendorSegmentScore",
  "$defs": {
    "VendorSegmentScore": {
      "properties": {
        "vendorId": {
          "type": "string"
        },
        "vendorName": {
          "type": "string"
        },
        "vendorColor": {
          "type": "string"
        },
        "weightedScore": {
          "type": "number"
        },
        "maxPossibleScore": {
          "type": "number"
        },
        "normalizedScore": {
          "type": "number"
        },
        "isFocusVendor": {
          "type": "boolean"
        },
        "rank": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}