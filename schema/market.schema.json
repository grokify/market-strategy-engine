{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/market-strategy-engine/schema/market.schema.json",
  "$ref": "#/$defs/Market",
  "$defs": {
    "Capability": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "gapType": {
          "type": "string"
        },
        "scoreRubric": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Market": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/ProductCategory"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ProductCategory": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}